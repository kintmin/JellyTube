<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  GENERATE_INFOPLIST_FILE 이 켜져 있어 나머지 키는 Xcode 가 채운다.
	  INFOPLIST_KEY_* 빌드 설정이 **무시하는 키만** 여기 적는다 — 아래 둘은 빌드 설정에
	  넣어도 생성된 plist 에 들어가지 않는다(확인된 동작).
	-->

	<!-- Compose Multiplatform 이 요구한다. 없으면 기동 직후 예외로 죽는다. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- 비워 두면 기동 중에 흰 화면이 뜬다. 색은 Assets 의 LaunchBackground 로, Compose 배경(dark80)과 같아야 첫 프레임에 색이 튀지 않는다. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!--
	  걸음수 측정(CMPedometer). 이 설명이 없으면 모션 API 를 건드리는 순간 앱이 죽는다.
	-->
	<key>NSMotionUsageDescription</key>
	<string>걸음수를 세기 위해 동작 및 피트니스 데이터를 사용합니다.</string>

	<!--
	  데이터 이전: 같은 Wi-Fi 의 Android 기기를 Bonjour 로 찾는다. 둘 중 하나라도 없으면 탐색이
	  오류 없이 0건으로 끝난다. 서비스 타입의 진원지는 `FileShareConstants.MIGRATION_NSD_SERVICE_TYPE` 이다.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Android 기기의 JellyTube 데이터를 옮겨 오기 위해 같은 네트워크의 기기를 찾습니다.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_jellytube-mig._tcp</string>
	</array>

	<!-- 데이터 이전: 보내는 기기의 서버는 평문 HTTP 다. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!--
	  딥링크 진입용 커스텀 스킴. 값의 진원지는 공통 `DeepLinkConstants.APP_SCHEME` 이다.
	  Android 는 같은 주소를 https App Links 로 받는다 — Universal Links 는 도메인에
	  apple-app-site-association 을 올린 뒤에 쓴다.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kintmin.JellyTubeIos.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jellytube</string>
			</array>
		</dict>
	</array>

	<!--
	  다른 앱의 공유 시트에서 "JellyTube 로 열기"가 뜨게 한다 — Android 의
	  `ACTION_SEND` intent-filter 에 대응하는 자리다.

	  `LSSupportsOpeningDocumentsInPlace` 는 켜지 않는다. 끄면 iOS 가 파일을
	  `Documents/Inbox/` 로 **복사해서** 넘겨 주는데, 어차피 앱이 자기 저장소로 복사해
	  들이므로 원본을 직접 건드릴 이유가 없다.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>오디오 파일</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>

	<!-- 화면이 꺼진 뒤에도 재생을 잇는다. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>

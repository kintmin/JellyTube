<?xml version="1.0" encoding="utf-8"?>
<!-- 배경 없는 스플래시 아이콘은 288dp 로 그려진다. 128dp 래스터를 그 크기로 늘리면 흐려지므로 원래 크기(44.4%)로 줄인다. -->
<!-- 런처 아이콘 이미지는 바깥이 불투명한 흰색이라 그대로 쓰면 흰 사각형이 보인다. splash_logo 는 그 흰 배경을 걷어낸 사본이다. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:inset="27.78%" />

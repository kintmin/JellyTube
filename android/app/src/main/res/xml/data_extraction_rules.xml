<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상. 클라우드 백업은 backup_rules.xml 과 같은 이유로 백업 사본 하나만 싣는다.
     기기 간 직접 이전(device-transfer)은 용량 한도가 없어 정하지 않고 기본(전부)을 둔다. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup/" />
    </cloud-backup>
</data-extraction-rules>
